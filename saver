local function findCapper()
    local g = (getgenv and getgenv()) or {}
    return g.setfpscap or _G.setfpscap or setfpscap or (syn and syn.setfpscap)
end

local cap = findCapper()
local fpsButtons = {}

local function highlight(btn)
    for _, b in ipairs(fpsButtons) do
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    end
    btn.BackgroundColor3 = Color3.fromRGB(0,100,0)
end

for _, v in ipairs({20,25,30,40,50,60,"Unlimited"}) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 22)
    btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Text = tostring(v)
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 14
    btn.Parent = fpsList

-- Performance + FPS Control Panel (Side by Side, All Options Visible)
-- Run via executor

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local Lighting = game:GetService("Lighting")

-- Persistent GUI
local gui = player:WaitForChild("PlayerGui"):FindFirstChild("PerfPanel")
if not gui then
    gui = Instance.new("ScreenGui")
    gui.Name = "PerfPanel"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Parent = player:WaitForChild("PlayerGui")
end

-- Graphics Preset Panel
local gfxFrame = Instance.new("Frame")
gfxFrame.Name = "GraphicsFrame"
gfxFrame.Size = UDim2.new(0, 120, 0, 80)
gfxFrame.Position = UDim2.new(1, -260, 0, 10) -- left side
gfxFrame.BackgroundColor3 = Color3.fromRGB(20,20,20)
gfxFrame.Parent = gui

local gfxLabel = Instance.new("TextLabel")
gfxLabel.Size = UDim2.new(1,0,0,20)
gfxLabel.BackgroundTransparency = 1
gfxLabel.TextColor3 = Color3.fromRGB(255,255,255)
gfxLabel.Text = "Graphics Preset"
gfxLabel.Parent = gfxFrame

local function applyPreset(level)
    if level == "Default" then
        gfxLabel.Text = "Graphics Preset: Default"
    elseif level == "ExtraLow" then
        for _, effect in pairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then effect.Enabled = false end
        end
        Lighting.GlobalShadows = false
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end
        workspace.Terrain.WaterWaveSize = 0
        workspace.Terrain.WaterWaveSpeed = 0
        workspace.Terrain.WaterReflectance = 0
        workspace.Terrain.WaterTransparency = 1
        gfxLabel.Text = "Graphics Preset: ExtraLow"
    elseif level == "UltraLow" then
        for _, effect in pairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then effect.Enabled = false end
        end
        Lighting.GlobalShadows = false
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
                obj.Color = Color3.new(0,0,0)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end
        workspace.Terrain.WaterWaveSize = 0
        workspace.Terrain.WaterWaveSpeed = 0
        workspace.Terrain.WaterReflectance = 0
        workspace.Terrain.WaterTransparency = 1
        gfxLabel.Text = "Graphics Preset: UltraLow"
    end
end

local gfxOptions = {"Default","ExtraLow","UltraLow"}
for i,v in ipairs(gfxOptions) do
    local opt = Instance.new("TextButton")
    opt.Size = UDim2.new(1,0,0,20)
    opt.Position = UDim2.new(0,0,0,i*20)
    opt.BackgroundColor3 = Color3.fromRGB(40,40,40)
    opt.TextColor3 = Color3.fromRGB(255,255,255)
    opt.Text = v
    opt.Parent = gfxFrame
    opt.MouseButton1Click:Connect(function()
        applyPreset(v)
    end)
end

-- FPS Cap Panel
local fpsFrame = Instance.new("Frame")
fpsFrame.Name = "FPSFrame"
fpsFrame.Size = UDim2.new(0, 120, 0, 140)
fpsFrame.Position = UDim2.new(1, -130, 0, 10) -- right side
fpsFrame.BackgroundColor3 = Color3.fromRGB(20,20,20)
fpsFrame.Parent = gui

local fpsLabel = Instance.new("TextLabel")
fpsLabel.Size = UDim2.new(1,0,0,20)
fpsLabel.BackgroundTransparency = 1
fpsLabel.TextColor3 = Color3.fromRGB(255,255,255)
fpsLabel.Text = "FPS Cap"
fpsLabel.Parent = fpsFrame

local function findCapper()
    local g = getgenv and getgenv() or {}
    return g.setfpscap or _G.setfpscap or setfpscap or (syn and (syn.set_fps or syn.setfpscap))
end
local cap = findCapper()

local fpsValues = {20,30,40,50,60,"Unlimited"}
for i,v in ipairs(fpsValues) do
    local opt = Instance.new("TextButton")
    opt.Size = UDim2.new(1,0,0,20)
    opt.Position = UDim2.new(0,0,0,i*20)
    opt.BackgroundColor3 = Color3.fromRGB(40,40,40)
    opt.TextColor3 = Color3.fromRGB(255,255,255)
    opt.Text = tostring(v)
    opt.Parent = fpsFrame
    opt.MouseButton1Click:Connect(function()
        if cap then
            if v == "Unlimited" then
                cap(1000)
                fpsLabel.Text = "FPS Cap: Unlimited"
            else
                cap(v)
                fpsLabel.Text = "FPS Cap: "..v
            end
        else
            fpsLabel.Text = "FPS Cap: No API"
        end
    end)
end

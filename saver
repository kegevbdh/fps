-- BACKEND: Cache originals
--------------------------------------------------
local originalData = {}

local function cacheObject(obj)
    if obj:IsA("BasePart") then
        originalData[obj] = {
            Material = obj.Material,
            Color = obj.Color,
            CastShadow = obj.CastShadow
        }
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        originalData[obj] = {
            Transparency = obj.Transparency
        }
    end
end

for _, obj in ipairs(workspace:GetDescendants()) do
    cacheObject(obj)
end

workspace.DescendantAdded:Connect(cacheObject)

local function restoreDefaults()
    for obj, data in pairs(originalData) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                obj.Material = data.Material
                obj.Color = data.Color
                obj.CastShadow = data.CastShadow
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = data.Transparency
            end
        end
    end
end

--------------------------------------------------
-- PRESET LOGIC
--------------------------------------------------
local function applyPreset(p)
    if p == "Default" then
        restoreDefaults()
        Lighting.GlobalShadows = true
        return
    end

    if p == "PostEffectsOff" or p == "ExtraLow" or p == "UltraLow" then
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then
                e.Enabled = false
            end
        end
    end

    if p == "ShadowsOff" or p == "ExtraLow" or p == "UltraLow" then
        Lighting.GlobalShadows = false
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CastShadow = false
            end
        end
    end

    if p == "DecalsOff" or p == "TexturesOff" or p == "ExtraLow" or p == "UltraLow" then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then
                d.Transparency = 1
            end
        end
    end

    if p == "SmoothPlastic" or p == "ExtraLow" or p == "UltraLow" then
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Material = Enum.Material.SmoothPlastic
            end
        end
    end

    if p == "TerrainSimplify" or p == "ExtraLow" or p == "UltraLow" then
        local t = workspace.Terrain
        t.WaterWaveSize = 0
        t.WaterWaveSpeed = 0
        t.WaterReflectance = 0
        t.WaterTransparency = 1
    end

    if p == "UltraLow" then
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Color = Color3.new(0,0,0)
            end
        end
    end
end


--------------------------------------------------
-- CACHE ORIGINAL WORLD STATE
--------------------------------------------------
local original = {}
local function cache(o)
	if o:IsA("BasePart") then
		original[o] = {o.Material, o.Color, o.CastShadow}
	elseif o:IsA("Decal") or o:IsA("Texture") then
		original[o] = {o.Transparency}
	end
end

for _,o in ipairs(workspace:GetDescendants()) do
	cache(o)
end

workspace.DescendantAdded:Connect(cache)

local function restore()
	for o,d in pairs(original) do
		if o:IsA("BasePart") then
			o.Material = d[1]
			o.Color = d[2]
			o.CastShadow = d[3]
		else
			o.Transparency = d[1]
		end
	end
end

--------------------------------------------------
-- APPLY PRESET FUNCTION
--------------------------------------------------
local function applyPreset(p)
	if p == "Default" then restore() return end
	if p == "PostEffectsOff" or p == "ExtraLow" or p == "UltraLow" then
		for _,e in ipairs(Lighting:GetChildren()) do if e:IsA("PostEffect") then e.Enabled = false end end
	end
	if p == "ShadowsOff" or p == "ExtraLow" or p == "UltraLow" then
		Lighting.GlobalShadows = false
		for _,x in ipairs(workspace:GetDescendants()) do if x:IsA("BasePart") then x.CastShadow = false end end
	end
	if p == "DecalsOff" or p == "TexturesOff" or p == "ExtraLow" or p == "UltraLow" then
		for _,x in ipairs(workspace:GetDescendants()) do if x:IsA("Decal") or x:IsA("Texture") then x.Transparency = 1 end end
	end
	if p == "SmoothPlastic" or p == "ExtraLow" or p == "UltraLow" then
		for _,x in ipairs(workspace:GetDescendants()) do if x:IsA("BasePart") then x.Material = Enum.Material.SmoothPlastic end end
	end
	if p == "TerrainSimplify" or p == "ExtraLow" or p == "UltraLow" then
		local t = workspace:FindFirstChild("Terrain")
		if t then
			t.WaterWaveSize = 0
			t.WaterWaveSpeed = 0
			t.WaterReflectance = 0
			t.WaterTransparency = 1
		end
	end
	if p == "UltraLow" then
		for _,x in ipairs(workspace:GetDescendants()) do if x:IsA("BasePart") then x.Color = Color3.new(0,0,0) end end
	end
end


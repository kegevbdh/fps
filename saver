Instance.new("UIListLayout", presets).Padding = UDim.new(0,4)

--------------------------------------------------
-- CACHE ORIGINALS
--------------------------------------------------
local original = {}
local function cache(o)
	if o:IsA("BasePart") then
		original[o] = {o.Material,o.Color,o.CastShadow}
	elseif o:IsA("Decal") or o:IsA("Texture") then
		original[o] = {o.Transparency}
	end
end
for _,o in pairs(workspace:GetDescendants()) do cache(o) end
workspace.DescendantAdded:Connect(cache)

local function restore()
	for o,d in pairs(original) do
		if o:IsA("BasePart") then
			o.Material,o.Color,o.CastShadow = d[1],d[2],d[3]
		else
			o.Transparency = d[1]
		end
	end
end

--------------------------------------------------
-- PRESETS
--------------------------------------------------
local function apply(p)
	if p=="Default" then restore() return end
	if p=="UltraLow" then
		for _,x in pairs(workspace:GetDescendants()) do
			if x:IsA("BasePart") then
				x.Material = Enum.Material.SmoothPlastic
				x.CastShadow = false
				x.Color = Color3.new(0,0,0)
			end
		end
		Lighting.GlobalShadows = false
	end
end

for _,n in ipairs({"Default","ExtraLow","UltraLow"}) do
	local b=Instance.new("TextButton",presets)
	b.Size=UDim2.new(1,0,0,22)
	b.Text=n
	b.TextColor3=Color3.new(1,1,1)
	b.BackgroundColor3=Color3.fromRGB(40,40,40)
	b.MouseButton1Click:Connect(function()
		apply(n)
	end)
end

--------------------------------------------------
-- FPS LIMITER (10–60)
--------------------------------------------------
local fpsBox = Instance.new("Frame", content)
fpsBox.Size = UDim2.new(1,-10,0,80)
fpsBox.BackgroundColor3 = Color3.fromRGB(20,20,20)
fpsBox.BorderSizePixel = 0

local fpsLayout = Instance.new("UIListLayout", fpsBox)
fpsLayout.Padding = UDim.new(0,4)

local fpsCap = 60
local accumulator = 0

RunService.RenderStepped:Connect(function(dt)
	accumulator += dt
	local interval = 1 / fpsCap
	if accumulator < interval then
		task.wait(interval - accumulator)
	end
	accumulator = 0
end)

for fps = 10, 60, 10 do
	local b = Instance.new("TextButton", fpsBox)
	b.Size = UDim2.new(1,0,0,22)
	b.Text = "FPS Cap: "..fps
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)

	b.MouseButton1Click:Connect(function()
		fpsCap = fps
	end)
end

--------------------------------------------------
-- MASTER DROPDOWN
--------------------------------------------------
local open = true
local fullSize = panel.Size

toggleBtn.MouseButton1Click:Connect(function()
	open = not open
	toggleBtn.Text = open and "▼" or "▶"
	panel:TweenSize(
		open and fullSize or UDim2.new(fullSize.X.Scale,fullSize.X.Offset,0,26),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quad,
		0.25,
		true
	)
end)

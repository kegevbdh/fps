    btn.MouseButton1Click:Connect(function()
        if cap then
            cap(v == "Unlimited" and 1000 or v)
            highlight(btn)
        else
            btn.Text = "No API"
            btn.BackgroundColor3 = Color3.fromRGB(100,0,0)
            task.delay(0.6, function()
                btn.Text = tostring(v)
                btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
            end)

--------------------------------------------------
-- PANEL DRAGGING + DROPDOWN for Graphics
--------------------------------------------------
local gfxDragging, gfxDragStart, gfxStartPos
local gfxOpen = true
local gfxExpandedSize = gfxFrame.Size

topBarGFX.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		gfxDragging = true
		gfxDragStart = input.Position
		gfxStartPos = gfxFrame.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		gfxDragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if gfxDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - gfxDragStart
		gfxFrame.Position = UDim2.new(
			gfxStartPos.X.Scale,
			gfxStartPos.X.Offset + delta.X,
			gfxStartPos.Y.Scale,
			gfxStartPos.Y.Offset + delta.Y
		)
	end
end)

toggleBtnGFX.MouseButton1Click:Connect(function()
	gfxOpen = not gfxOpen
	if gfxOpen then
		toggleBtnGFX.Text = "▼"
		gfxFrame:TweenSize(gfxExpandedSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
	else
		toggleBtnGFX.Text = "▶"
		gfxFrame:TweenSize(
			UDim2.new(gfxExpandedSize.X.Scale, gfxExpandedSize.X.Offset, 0, 22),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			0.2,
			true
		)
	end
end)


--------------------------------------------------
-- DROPDOWN TOGGLE
--------------------------------------------------
local open = true
local expandedSize = panel.Size
local collapsedHeight = 26

toggleBtn.MouseButton1Click:Connect(function()
    open = not open
    if open then
        toggleBtn.Text = "▼"
        panel:TweenSize(expandedSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    else
        toggleBtn.Text = "▶"
        panel:TweenSize(UDim2.new(expandedSize.X.Scale, expandedSize.X.Offset, 0, collapsedHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    end
end)

--------------------------------------------------
-- PANEL DRAGGING
--------------------------------------------------
do
    local dragging = false
    local dragStart = nil
    local startPos = nil

    panel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
        end
    end)

    panel.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    panel.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

--------------------------------------------------
-- GRAPHICS PRESETS
--------------------------------------------------
local originalData = {}
local function cacheObject(obj)
    if obj:IsA("BasePart") then
        originalData[obj] = {Material=obj.Material, Color=obj.Color, CastShadow=obj.CastShadow}
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        originalData[obj] = {Transparency=obj.Transparency}
    end
end

for _, obj in pairs(workspace:GetDescendants()) do cacheObject(obj) end
workspace.DescendantAdded:Connect(cacheObject)

local function restoreDefaults()
    for obj,data in pairs(originalData) do
        if obj:IsA("BasePart") then
            obj.Material=data.Material
            obj.Color=data.Color
            obj.CastShadow=data.CastShadow
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency=data.Transparency
        end
    end
end

local function applyPreset(p)
    if p=="Default" then restoreDefaults() return end
    if p=="PostEffectsOff" or p=="ExtraLow" or p=="UltraLow" then
        for _,effect in pairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then effect.Enabled=false end
        end
    end
    if p=="ShadowsOff" or p=="ExtraLow" or p=="UltraLow" then
        Lighting.GlobalShadows=false
        for _,part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then part.CastShadow=false end
        end
    end
    if p=="DecalsOff" or p=="TexturesOff" or p=="ExtraLow" or p=="UltraLow" then
        for _,d in pairs(workspace:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then d.Transparency=1 end
        end
    end
    if p=="SmoothPlastic" or p=="ExtraLow" or p=="UltraLow" then
        for _,part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then part.Material=Enum.Material.SmoothPlastic end
        end
    end
    if p=="TerrainSimplify" or p=="ExtraLow" or p=="UltraLow" then
        workspace.Terrain.WaterWaveSize=0
        workspace.Terrain.WaterWaveSpeed=0
        workspace.Terrain.WaterReflectance=0
        workspace.Terrain.WaterTransparency=1
    end
    if p=="UltraLow" then
        for _,part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then part.Color=Color3.new(0,0,0) end
        end
    end
end

local presetOptions = {"Default","PostEffectsOff","ShadowsOff","DecalsOff","TexturesOff","SmoothPlastic","TerrainSimplify","ExtraLow","UltraLow"}
for _,name in ipairs(presetOptions) do
    local b = Instance.new("TextButton")
    b.Size=UDim2.new(1,0,0,22)
    b.BackgroundColor3=Color3.fromRGB(40,40,40)
    b.TextColor3=Color3.fromRGB(255,255,255)
    b.Text=name
    b.Parent=gfxScroll
    b.MouseButton1Click:Connect(function()
        applyPreset(name)
        b.BackgroundColor3=Color3.fromRGB(0,100,0)
        task.delay(0.2,function() b.BackgroundColor3=Color3.fromRGB(40,40,40) end)
    end)
end


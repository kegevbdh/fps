--------------------------------------------------
-- PANEL DRAGGING (applies to whole panel)
--------------------------------------------------
local dragging, dragStart, startPos
topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = panel.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

--------------------------------------------------
-- DROPDOWN TOGGLE (FIXED)
--------------------------------------------------
local open = true
local expandedHeight = gfxFrame.Size.Y.Offset -- original height
local collapsedHeight = 22 -- topbar height

toggleBtn.MouseButton1Click:Connect(function()
    open = not open
    if open then
        toggleBtn.Text = "▼"
        gfxFrame:TweenSize(UDim2.new(0, gfxFrame.Size.X.Offset, 0, expandedHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        fpsFrame:TweenSize(UDim2.new(0, fpsFrame.Size.X.Offset, 0, expandedHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    else
        toggleBtn.Text = "▶"
        gfxFrame:TweenSize(UDim2.new(0, gfxFrame.Size.X.Offset, 0, collapsedHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        fpsFrame:TweenSize(UDim2.new(0, fpsFrame.Size.X.Offset, 0, collapsedHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    end
end)

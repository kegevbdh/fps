local function findCapper()
    local g = getgenv and getgenv() or {}
    return g.setfpscap or _G.setfpscap or setfpscap or (syn and (syn.set_fps or syn.setfpscap))
end
local cap = findCapper()

local fpsButtons = {}
local function setFPSHighlight(selectedBtn)
    for _, btn in ipairs(fpsButtons) do
        btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    end
    selectedBtn.BackgroundColor3 = Color3.fromRGB(0,100,0)
end

local fpsValues = {20,25,30,35,40,45,50,55,60,"Unlimited"}
for _, v in ipairs(fpsValues) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 22)
    btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Text = tostring(v)
    btn.Parent = fpsList
    table.insert(fpsButtons, btn)

    btn.MouseButton1Click:Connect(function()
        if cap then
            if v == "Unlimited" then
                cap(1000)
            else
                cap(v)
            end
            setFPSHighlight(btn)
        else
            btn.Text = tostring(v).." (No API)"
            btn.BackgroundColor3 = Color3.fromRGB(100,0,0)
            task.delay(0.6, function()
                btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
                btn.Text = tostring(v)
            end)
        end
    end)
end


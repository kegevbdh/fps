--------------------------------------------------
-- FIND FPS CAPPER (DELTA / SYN / GLOBAL)
--------------------------------------------------
local function findCapper()
	local g = getgenv and getgenv() or {}
	return g.setfpscap
		or _G.setfpscap
		or setfpscap
		or (syn and (syn.set_fps or syn.setfpscap))
end

local setCap = findCapper()


--------------------------------------------------
-- PANEL DRAGGING (entire panel)
--------------------------------------------------
do
    local dragging, dragStart, startPos

    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, 0, 22)
    topBar.BackgroundTransparency = 1
    topBar.Parent = panel

    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--------------------------------------------------
-- DROPDOWN TOGGLE (gfx + fps together)
--------------------------------------------------
do
    local open = true
    local expandedSize = panel.Size
    local collapsedHeight = 22 -- top bar height only

    toggleBtn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            toggleBtn.Text = "▼"
            panel:TweenSize(expandedSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        else
            toggleBtn.Text = "▶"
            panel:TweenSize(
                UDim2.new(expandedSize.X.Scale, expandedSize.X.Offset, 0, collapsedHeight),
                Enum.EasingDirection.Out,
                Enum.EasingStyle.Quad,
                0.2,
                true
            )
        end
    end)
end

--------------------------------------------------
-- GRAPHICS PRESETS LIST
--------------------------------------------------
local originalData = {}

local function cacheObject(obj)
    if obj:IsA("BasePart") then
        originalData[obj] = {Material = obj.Material, Color = obj.Color, CastShadow = obj.CastShadow}
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        originalData[obj] = {Transparency = obj.Transparency}
    end
end

for _, obj in pairs(workspace:GetDescendants()) do
    cacheObject(obj)
end
workspace.DescendantAdded:Connect(cacheObject)

local function restoreDefaults()
    for obj, data in pairs(originalData) do
        if obj:IsA("BasePart") then
            obj.Material = data.Material
            obj.Color = data.Color
            obj.CastShadow = data.CastShadow
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = data.Transparency
        end
    end
end

local function applyPreset(p)
    if p == "Default" then
        restoreDefaults()
        return
    end
    if p == "PostEffectsOff" or p == "ExtraLow" or p == "UltraLow" then
        for _, effect in pairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then effect.Enabled = false end
        end
    end
    if p == "ShadowsOff" or p == "ExtraLow" or p == "UltraLow" then
        Lighting.GlobalShadows = false
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then part.CastShadow = false end
        end
    end
    if p == "DecalsOff" or p == "TexturesOff" or p == "ExtraLow" or p == "UltraLow" then
        for _, d in pairs(workspace:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then d.Transparency = 1 end
        end
    end
    if p == "SmoothPlastic" or p == "ExtraLow" or p == "UltraLow" then
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then part.Material = Enum.Material.SmoothPlastic end
        end
    end
    if p == "TerrainSimplify" or p == "ExtraLow" or p == "UltraLow" then
        workspace.Terrain.WaterWaveSize = 0
        workspace.Terrain.WaterWaveSpeed = 0
        workspace.Terrain.WaterReflectance = 0
        workspace.Terrain.WaterTransparency = 1
    end
    if p == "UltraLow" then
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then part.Color = Color3.new(0, 0, 0) end
        end
    end
end

local presetOptions = {
    "Default", "PostEffectsOff", "ShadowsOff", "DecalsOff",
    "TexturesOff", "SmoothPlastic", "TerrainSimplify", "ExtraLow", "UltraLow"
}

for _, name in ipairs(presetOptions) do
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 22)
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Text = name
    b.Parent = presetsScroll
    b.MouseButton1Click:Connect(function()
        applyPreset(name)
        b.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
        task.delay(0.2, function() b.BackgroundColor3 = Color3.fromRGB(40, 40, 40) end)
    end)
end

--------------------------------------------------
-- FPS BUTTONS
--------------------------------------------------
local function findCapper()
    local g = getgenv and getgenv() or {}
    return g.setfpscap or _G.setfpscap or setfpscap or (syn and (syn.set_fps or syn.setfpscap))
end
local cap = findCapper()

local fpsValues = {20, 25, 30, 35, 40, 45, 50, 55, 60, "Unlimited"}
local fpsButtons = {}

local function setFPSHighlight(selectedBtn)
    for _, btn in ipairs(fpsButtons) do
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    end
    selectedBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
end

for _, v in ipairs(fpsValues) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 22)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = tostring(v)
    btn.Parent = fpsList
    table.insert(fpsButtons, btn)

    btn.MouseButton1Click:Connect(function()
        if cap then
            if v == "Unlimited" then
                cap(1000)
            else
                cap(v)
            end
            setFPSHighlight(btn)
        else
            btn.Text = tostring(v) .. " (No API)"
            btn.BackgroundColor3 = Color3.fromRGB(100, 0, 0)
            task.delay(0.6, function()
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                btn.Text = tostring(v)
            end)
        end
    end)
end

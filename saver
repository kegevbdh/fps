-- ORIGINAL BACKEND + PRESET LOGIC (copied exactly from your original)
local originalData = {}
local function cacheObject(obj)
	if obj:IsA("BasePart") then
		originalData[obj] = {Material = obj.Material, Color = obj.Color, CastShadow = obj.CastShadow}
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		originalData[obj] = {Transparency = obj.Transparency}
	end
end
for _, obj in pairs(workspace:GetDescendants()) do cacheObject(obj) end
workspace.DescendantAdded:Connect(cacheObject)

local function restoreDefaults()
	for obj,data in pairs(originalData) do
		if obj:IsA("BasePart") then
			obj.Material = data.Material
			obj.Color = data.Color
			obj.CastShadow = data.CastShadow
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			obj.Transparency = data.Transparency
		end
	end
end

local function applyPreset(p)
	if p=="Default" then restoreDefaults() return end
	if p=="PostEffectsOff" or p=="ExtraLow" or p=="UltraLow" then
		for _,e in pairs(Lighting:GetChildren()) do if e:IsA("PostEffect") then e.Enabled=false end end
	end
	if p=="ShadowsOff" or p=="ExtraLow" or p=="UltraLow" then
		Lighting.GlobalShadows=false
		for _,part in pairs(workspace:GetDescendants()) do
			if part:IsA("BasePart") then part.CastShadow=false end
		end
	end
	if p=="DecalsOff" or p=="TexturesOff" or p=="ExtraLow" or p=="UltraLow" then
		for _,d in pairs(workspace:GetDescendants()) do
			if d:IsA("Decal") or d:IsA("Texture") then d.Transparency=1 end
		end
	end
	if p=="SmoothPlastic" or p=="ExtraLow" or p=="UltraLow" then
		for _,part in pairs(workspace:GetDescendants()) do
			if part:IsA("BasePart") then part.Material=Enum.Material.SmoothPlastic end
		end
	end
	if p=="TerrainSimplify" or p=="ExtraLow" or p=="UltraLow" then
		workspace.Terrain.WaterWaveSize=0
		workspace.Terrain.WaterWaveSpeed=0
		workspace.Terrain.WaterReflectance=0
		workspace.Terrain.WaterTransparency=1
	end
	if p=="UltraLow" then
		for _,part in pairs(workspace:GetDescendants()) do
			if part:IsA("BasePart") then part.Color=Color3.new(0,0,0) end
		end
	end
end


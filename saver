--------------------------------------------------
-- LEFT: Graphics Presets (scrollable, restorable, draggable, collapsible)
--------------------------------------------------
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local gfxFrame = Instance.new("Frame")
gfxFrame.Name = "GraphicsFrame"
gfxFrame.Size = UDim2.new(0, 125, 0, 180)
gfxFrame.Position = UDim2.new(0, 0, 0, 0)
gfxFrame.BackgroundColor3 = Color3.fromRGB(20,20,20)
gfxFrame.Parent = panel

-- Top bar for dragging + toggle
local gfxTopBar = Instance.new("Frame")
gfxTopBar.Name = "TopBar"
gfxTopBar.Size = UDim2.new(1, 0, 0, 22)
gfxTopBar.BackgroundColor3 = Color3.fromRGB(30,30,30)
gfxTopBar.Parent = gfxFrame

local gfxHeader = Instance.new("TextLabel")
gfxHeader.Size = UDim2.new(1, -22, 1, 0)
gfxHeader.Position = UDim2.new(0, 0, 0, 0)
gfxHeader.BackgroundTransparency = 1
gfxHeader.TextColor3 = Color3.fromRGB(255,255,255)
gfxHeader.Text = "Graphics Presets"
gfxHeader.Font = Enum.Font.SourceSansBold
gfxHeader.TextSize = 16
gfxHeader.Parent = gfxTopBar

local gfxToggleBtn = Instance.new("TextButton")
gfxToggleBtn.Size = UDim2.new(0, 22, 1, 0)
gfxToggleBtn.Position = UDim2.new(1, -22, 0, 0)
gfxToggleBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
gfxToggleBtn.TextColor3 = Color3.fromRGB(255,255,255)
gfxToggleBtn.Text = "▼"
gfxToggleBtn.Font = Enum.Font.SourceSansBold
gfxToggleBtn.TextSize = 16
gfxToggleBtn.Parent = gfxTopBar

local presetsScroll = Instance.new("ScrollingFrame")
presetsScroll.Name = "PresetsScroll"
presetsScroll.Size = UDim2.new(1, -6, 1, -26)
presetsScroll.Position = UDim2.new(0, 3, 0, 24)
presetsScroll.BackgroundTransparency = 1
presetsScroll.ScrollBarThickness = 6
presetsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
presetsScroll.Parent = gfxFrame

local listLayout = Instance.new("UIListLayout")
listLayout.Parent = presetsScroll
listLayout.Padding = UDim.new(0, 4)

--------------------------------------------------
-- PANEL DRAGGING (gfxFrame)
--------------------------------------------------
do
    local dragging, dragStart, startPos

    gfxTopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = gfxFrame.Position
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            gfxFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--------------------------------------------------
-- DROPDOWN TOGGLE (gfxFrame)
--------------------------------------------------
do
    local open = true
    local expandedSize = gfxFrame.Size

    gfxToggleBtn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            gfxToggleBtn.Text = "▼"
            gfxFrame:TweenSize(expandedSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        else
            gfxToggleBtn.Text = "▶"
            gfxFrame:TweenSize(
                UDim2.new(expandedSize.X.Scale, expandedSize.X.Offset, 0, 22),
                Enum.EasingDirection.Out,
                Enum.EasingStyle.Quad,
                0.2,
                true
            )
        end
    end)
end


local function findCapper()
    local g=getgenv and getgenv() or {}
    return g.setfpscap or _G.setfpscap or setfpscap or (syn and (syn.set_fps or syn.setfpscap))
end
local cap = findCapper()

local fpsValues = {20,25,30,35,40,45,50,55,60,"Unlimited"}
local fpsButtons = {}
local function setFPSHighlight(btn)
    for _,b in ipairs(fpsButtons) do b.BackgroundColor3=Color3.fromRGB(40,40,40) end
    btn.BackgroundColor3=Color3.fromRGB(0,100,0)
end

for _,v in ipairs(fpsValues) do
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,0,0,22)
    b.BackgroundColor3=Color3.fromRGB(40,40,40)
    b.TextColor3=Color3.fromRGB(255,255,255)
    b.Text=tostring(v)
    b.Parent=fpsListFrame
    table.insert(fpsButtons,b)
    b.MouseButton1Click:Connect(function()
        if cap then
            if v=="Unlimited" then cap(1000) else cap(v) end
            setFPSHighlight(b)
        else
            b.Text=tostring(v).." (No API)"
            b.BackgroundColor3=Color3.fromRGB(100,0,0)
            task.delay(0.6,function() b.BackgroundColor3=Color3.fromRGB(40,40,40) b.Text=tostring(v) end)
        end
    end)
end

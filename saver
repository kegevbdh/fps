-- Cache
local original={}
local function cache(o)
    if o:IsA("BasePart") then
        original[o]={o.Material,o.Color,o.CastShadow}
    elseif o:IsA("Decal") or o:IsA("Texture") then
        original[o]={o.Transparency}
    end
end
for _,o in pairs(workspace:GetDescendants()) do cache(o) end
workspace.DescendantAdded:Connect(cache)

local function restore()
    for o,d in pairs(original) do
        if o:IsA("BasePart") then
            o.Material,o.Color,o.CastShadow=d[1],d[2],d[3]
        else o.Transparency=d[1] end
    end
end

-- Presets
local function apply(p)
    if p=="Default" then restore() return end
    if p=="PostEffectsOff" or p=="ExtraLow" or p=="UltraLow" then
        for _,e in pairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then e.Enabled=false end
        end
    end
    if p=="ShadowsOff" or p=="ExtraLow" or p=="UltraLow" then
        Lighting.GlobalShadows=false
        for _,x in pairs(workspace:GetDescendants()) do
            if x:IsA("BasePart") then x.CastShadow=false end
        end
    end
    if p=="DecalsOff" or p=="TexturesOff" or p=="ExtraLow" or p=="UltraLow" then
        for _,x in pairs(workspace:GetDescendants()) do
            if x:IsA("Decal") or x:IsA("Texture") then x.Transparency=1 end
        end
    end
    if p=="SmoothPlastic" or p=="ExtraLow" or p=="UltraLow" then
        for _,x in pairs(workspace:GetDescendants()) do
            if x:IsA("BasePart") then x.Material=Enum.Material.SmoothPlastic end
        end
    end
    if p=="TerrainSimplify" or p=="ExtraLow" or p=="UltraLow" then
        local t=workspace.Terrain
        t.WaterWaveSize,t.WaterWaveSpeed,t.WaterReflectance,t.WaterTransparency=0,0,0,1
    end
    if p=="UltraLow" then
        for _,x in pairs(workspace:GetDescendants()) do
            if x:IsA("BasePart") then x.Color=Color3.new(0,0,0) end
        end
    end
end

local names={"Default","PostEffectsOff","ShadowsOff","DecalsOff","TexturesOff","SmoothPlastic","TerrainSimplify","ExtraLow","UltraLow"}
for _,n in ipairs(names) do
    local b=Instance.new("TextButton",presets)
    b.Size=UDim2.new(1,0,0,22)
    b.Text=n
    b.BackgroundColor3=Color3.fromRGB(40,40,40)
    b.TextColor3=Color3.new(1,1,1)
    b.MouseButton1Click:Connect(function()
        apply(n)
        b.BackgroundColor3=Color3.fromRGB(0,100,0)
        task.delay(0.2,function() b.BackgroundColor3=Color3.fromRGB(40,40,40) end)
    end)
end

